# The VSIX ships dist/extension.js, dist/server.js, vendor/playwright,
# vendor/playwright-core, plus the manifest, README, LICENSE, CHANGELOG,
# SUPPORT, PRIVACY, and icon.png. Playwright cannot be bundled: its driver
# resolves files inside its own package.
.vscode/**
.git/**
.gitignore
.vscodeignore
.github/**
src/**
test/**
docs-local/**
scripts/**
node_modules/**
esbuild.mjs
tsconfig.json
package-lock.json
AGENTS.md
PUBLISHING.md
FEATURE-REQUEST.md
ROADMAP.md
*.vsix
*.vsixmap
**/*.map
**/*.log
.DS_Store
